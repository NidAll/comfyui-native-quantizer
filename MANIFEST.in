include LICENSE README.md CHANGELOG.md CONTRIBUTING.md
include requirements*.txt architecture_template.json tests_support.py test_*.py
recursive-include docs *.md
recursive-include scripts *.py
recursive-include .github *.yml *.yaml *.md
recursive-include skills *.md *.yaml
prune quantizer_tui
exclude AGENTS.md requirements-tui.txt test_quantizer_tui.py
global-exclude __pycache__ *.py[cod] *.log *.safetensors *.ckpt *.pt *.pth *.bin *.gguf
